# ==============================================================================
# DEVELOPER PORTFOLIO & CMS PLATFORM — ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# This template documents all environment variables required for running the
# application locally or deploying to production container environments.
# 
# Usage:
#   - For local development: cp .env.example backend/.env
#   - For production Docker Compose: cp .env.example .env (fill real secrets)
#   - DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Comma-separated list of allowed frontend origins (no trailing slashes)
# In production, set to your live frontend URL (e.g., https://your-portfolio.vercel.app)
CORS_ORIGIN=https://your-portfolio-frontend.vercel.app

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------
# Local Docker container: mongodb://mongo:27017/portfolio
# Local host installation: mongodb://localhost:27017/portfolio
# Production MongoDB Atlas:
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
# MONGODB_URI is also supported as an alias for DATABASE_URL:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Generate strong 64-character hex strings:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_random_32_byte_secret_hex_minimum_length
JWT_REFRESH_SECRET=your_different_strong_random_32_byte_refresh_secret_hex
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 4. INITIAL ADMINISTRATOR SEED OVERRIDES (OPTIONAL)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@portfolio.dev
INITIAL_ADMIN_PASSWORD=YourStrongPasswordHere!123

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (CLOUDFLARE R2 / S3-COMPATIBLE)
# ------------------------------------------------------------------------------
# Cloudflare R2 provides S3-compatible, zero-egress-fee object storage for images and CVs.
# Obtain credentials from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=portfolio-media
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE FALLBACK (CLOUDINARY)
# ------------------------------------------------------------------------------
# Obtain from Cloudinary Console -> Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE (RESEND HTTP API OR SMTP VIA NODEMAILER)
# ------------------------------------------------------------------------------
# NOTE: Render Free Tier blocks outbound SMTP ports (25, 465, 587).
# For Render, provide a free Resend API key (https://resend.com) over HTTPS Port 443:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# For VPS, Railway, or standard SMTP:
# For Gmail, generate a 16-character App Password at:
#   Google Account -> Security -> 2-Step Verification -> App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-google-16-char-app-password
EMAIL_FROM="Portfolio Notifications <your-email@gmail.com>"

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & LOGGING
# ------------------------------------------------------------------------------
# 15 minutes window (900,000 ms), maximum 100 requests per IP address
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging verbosity: 'error' | 'warn' | 'info' | 'http' | 'debug'
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 9. FIREBASE ADMIN SDK (OPTIONAL AUTHENTICATION INTEGRATION)
# ------------------------------------------------------------------------------
# Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
