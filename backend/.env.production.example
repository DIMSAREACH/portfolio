# ==========================================
# Production Environment Configuration Template
# ==========================================
# Copy or set these in your production host (Render, Railway, VPS, etc.)
# DO NOT COMMIT YOUR REAL .env FILE WITH PRODUCTION SECRETS!

# Server
NODE_ENV=production
PORT=10000
# Comma-separated list of allowed frontend origins (e.g., https://sareach.dev,https://portfolio.vercel.app)
CORS_ORIGIN=https://your-portfolio-frontend.vercel.app

# Database (MongoDB Atlas)
# Provision an M0 free tier cluster at https://www.mongodb.com/atlas
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT Authentication
# Generate strong 64-character random hex keys using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_generated_strong_32_byte_secret_hex
JWT_REFRESH_SECRET=replace_with_different_generated_strong_32_byte_secret_hex
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Initial Admin User Credentials (Optional override for seed script)
INITIAL_ADMIN_EMAIL=your-admin-email@domain.com
INITIAL_ADMIN_PASSWORD=YourStrongPasswordHere!123

# Cloudinary Media Storage
# Create an account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Nodemailer)
# Gmail App Password or SendGrid/Resend SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-google-app-password
EMAIL_FROM="Dim Sareach Portfolio <your-email@gmail.com>"

# Rate Limiting (15 minutes window, max 100 requests per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Level
LOG_LEVEL=info

# Firebase Admin Authentication (Production)
# Generate a service account private key in Firebase Console -> Project Settings -> Service accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

